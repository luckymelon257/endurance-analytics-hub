<%- include('../partials/head', { title }) %>

<div class="flex min-h-screen">
  <%- include('../partials/auth-brand-panel') %>

  <main class="flex w-full md:w-1/2 items-center justify-center px-6 py-12 sm:px-10">
    <div class="w-full max-w-sm">
      <header class="mb-8 md:hidden flex items-center gap-2 text-ink">
        <span class="logo-mask h-7 w-7 text-brand" aria-hidden="true"></span>
        <p class="text-sm font-semibold tracking-wide">Endurance Analytics Hub</p>
      </header>

      <h1 class="text-3xl font-bold tracking-tight text-ink">Welcome back</h1>
      <p class="mt-2 text-sm text-ink-muted">
        Sign in to continue your training analytics.
      </p>

      <% if (locals.query && locals.query.verified) { %>
        <div
          role="status"
          class="mt-6 rounded-xl bg-emerald-50 px-4 py-3 text-sm text-emerald-800 ring-1 ring-inset ring-emerald-600/20"
        >
          Email verified. You can now sign in.
        </div>
      <% } %>

      <%
        const stravaErrorMessages = {
          denied:   'You declined the Strava authorization. You can try again anytime.',
          invalid:  'That Strava authorization link expired or was invalid. Please retry.',
          scope:    'Strava authorization is missing a required permission. Please retry and accept all permissions.',
          conflict: 'That Strava account is already connected to another user.',
          failed:   'Something went wrong while connecting to Strava. Please try again.',
        }
        const stravaError = locals.query && locals.query.strava_error
      %>
      <% if (stravaError && stravaErrorMessages[stravaError]) { %>
        <div
          role="alert"
          class="mt-6 rounded-xl bg-red-50 px-4 py-3 text-sm text-red-800 ring-1 ring-inset ring-red-600/20"
        >
          <%= stravaErrorMessages[stravaError] %>
        </div>
      <% } %>

      <!--
        hx-boost="false": the login form needs a full reload on failure so the
        server can re-render the page with an error message — boost would
        silently drop a 401 response.
      -->
      <form method="POST" action="/auth/login" class="mt-8 space-y-5" novalidate hx-boost="false">
        <div>
          <label for="email" class="block text-sm font-medium text-ink">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            inputmode="email"
            autocomplete="email"
            autofocus
            required
            aria-required="true"
            class="mt-1.5 block w-full rounded-xl border border-border bg-white px-3.5 py-2.5 text-sm text-ink shadow-sm transition placeholder:text-ink-subtle focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/30"
          />
        </div>

        <div>
          <div class="flex items-baseline justify-between">
            <label for="password" class="block text-sm font-medium text-ink">Password</label>
            <a href="/auth/forgot-password" class="text-xs font-medium text-brand hover:text-brand-700">
              Forgot password?
            </a>
          </div>
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="current-password"
            required
            aria-required="true"
            class="mt-1.5 block w-full rounded-xl border border-border bg-white px-3.5 py-2.5 text-sm text-ink shadow-sm transition placeholder:text-ink-subtle focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/30"
          />
        </div>

        <button
          type="submit"
          class="w-full rounded-xl bg-brand px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-brand focus:ring-offset-2"
        >
          Sign in
        </button>
      </form>

      <div class="my-6 flex items-center gap-3" role="separator" aria-orientation="horizontal">
        <div class="h-px flex-1 bg-border"></div>
        <span class="text-xs uppercase tracking-wider text-ink-subtle">or</span>
        <div class="h-px flex-1 bg-border"></div>
      </div>

      <a
        href="/auth/strava/connect"
        hx-boost="false"
        class="flex w-full items-center justify-center gap-2 rounded-xl border-2 border-brand bg-white px-4 py-2.5 text-sm font-semibold text-brand transition hover:bg-brand-50 focus:outline-none focus:ring-2 focus:ring-brand focus:ring-offset-2"
      >
        <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="m15.387 17.944-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599 2.836 5.598h4.172L10.463 0l-7 13.828h4.169" />
        </svg>
        Continue with Strava
      </a>

      <p class="mt-8 text-center text-sm text-ink-muted">
        Don't have an account?
        <a href="/auth/register" class="font-semibold text-brand hover:text-brand-700">
          Create one
        </a>
      </p>
    </div>
  </main>
</div>

<%- include('../partials/footer') %>
