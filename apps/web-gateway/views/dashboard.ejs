<%- include('partials/head', { title }) %>
<%- include('partials/navbar', { user }) %>

<main class="mx-auto flex min-h-screen max-w-7xl flex-col px-4 py-8 sm:px-6 lg:px-8">
  <%- include('partials/backfill-banner', { job: backfillJob }) %>

  <% if (stravaFlash === 'connected') { %>
    <div role="status" class="mb-6 rounded-xl bg-emerald-50 px-4 py-3 text-sm text-emerald-800 ring-1 ring-inset ring-emerald-600/20">
      Strava connected. Your recent activities are syncing in the background — refresh in a moment.
    </div>
  <% } else if (stravaFlash === 'new') { %>
    <div role="status" class="mb-6 rounded-xl bg-brand-50 px-4 py-3 text-sm text-brand-800 ring-1 ring-inset ring-brand/20">
      Welcome! We created your account from your Strava profile. Set a real email and password from your profile when you're ready.
    </div>
  <% } else if (stravaFlash === 'disconnected') { %>
    <div role="status" class="mb-6 rounded-xl bg-stone-100 px-4 py-3 text-sm text-ink-muted ring-1 ring-inset ring-border">
      Strava disconnected.
    </div>
  <% } %>

  <header class="mb-8">
    <h1 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">
      Welcome back, <%= user.firstName %>!
    </h1>
    <p class="mt-1 flex items-center gap-2 text-sm text-ink-muted">
      Here's your training overview.
      <span class="inline-flex items-center rounded-full bg-brand-50 px-2 py-0.5 text-xs font-medium text-brand-700 ring-1 ring-inset ring-brand/20">
        <%= user.role %>
      </span>
    </p>
  </header>

  <!-- Strava integration -->
  <section
    aria-labelledby="strava-heading"
    class="mb-6 overflow-hidden rounded-2xl bg-card shadow-sm ring-1 ring-border"
  >
    <div class="flex flex-col items-start justify-between gap-3 px-6 py-4 sm:flex-row sm:items-center">
      <div class="flex items-center gap-3">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand/10 text-brand" aria-hidden="true">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="m15.387 17.944-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599 2.836 5.598h4.172L10.463 0l-7 13.828h4.169" />
          </svg>
        </span>
        <div>
          <p id="strava-heading" class="text-sm font-semibold text-ink">Strava</p>
          <% if (stravaConnected) { %>
            <p class="text-xs text-ink-muted">
              Connected<% if (stravaAthleteName) { %> as <%= stravaAthleteName %><% } %>
            </p>
          <% } else { %>
            <p class="text-xs text-ink-muted">Not connected — link your account to import activities.</p>
          <% } %>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <% if (stravaConnected) { %>
          <button
            type="button"
            hx-post="/strava/sync"
            hx-swap="none"
            class="rounded-lg bg-brand px-3 py-1.5 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700 disabled:opacity-60"
          >
            Sync from Strava
          </button>
          <button
            type="button"
            hx-post="/strava/disconnect"
            hx-swap="none"
            hx-confirm="Disconnect Strava? You can reconnect any time."
            class="rounded-lg border border-border bg-card px-3 py-1.5 text-sm font-semibold text-ink-muted shadow-sm transition hover:bg-stone-50 hover:text-ink"
          >
            Disconnect
          </button>
        <% } else { %>
          <a href="/auth/strava/connect" hx-boost="false" class="rounded-lg bg-brand px-3 py-1.5 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700">
            Link Strava
          </a>
        <% } %>
      </div>
    </div>
  </section>

  <!--
    Dashboard data sections: stats / heatmap / recent / weekly volume.
    Wrapped so a syncCompleted event (dispatched by the server's HX-Trigger
    header after /strava/sync) can re-fetch this partial without a page reload.
  -->
  <div
    id="dashboard-data"
    hx-get="/partials/dashboard/data?year=<%= encodeURIComponent(String(heatmapYear)) %>"
    hx-trigger="syncCompleted from:body"
    hx-swap="innerHTML"
  >
    <%- include('partials/dashboard-data', { dashboard, heatmapYear, stravaConnected }) %>
  </div>

  <!-- Data & Reports -->
  <section
    aria-labelledby="reports-heading"
    class="mt-8 overflow-hidden rounded-2xl bg-card shadow-sm ring-1 ring-border"
  >
    <div class="border-b border-border px-6 py-4">
      <h2 id="reports-heading" class="text-lg font-semibold text-ink">Data & Reports</h2>
      <p class="mt-1 text-sm text-ink-muted">Download your activities or import from a file</p>
    </div>

    <div class="px-6 py-6">
      <!-- Export Section -->
      <div class="mb-8">
        <h3 class="mb-4 text-sm font-semibold text-ink">Export Monthly Report</h3>
        <div class="flex flex-wrap gap-3">
          <a
            href="/reports/export/excel"
            hx-boost="false"
            download
            class="inline-flex items-center gap-2 rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
            </svg>
            Download Excel
          </a>
          <a
            href="/reports/export/word"
            hx-boost="false"
            download
            class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700"
          >
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
            </svg>
            Download Word Report
          </a>
        </div>
        <p class="mt-2 text-xs text-ink-muted">Generates a report of all your activities from the current month.</p>
      </div>

      <!-- Import Section -->
      <div class="border-t border-border pt-6">
        <h3 class="mb-4 text-sm font-semibold text-ink">Import Activities</h3>
        <form
          method="POST"
          action="/reports/import"
          enctype="multipart/form-data"
          hx-boost="false"
        >
          <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-end">
            <div class="flex-1">
              <label for="import-file" class="block text-xs font-medium text-ink-muted mb-1.5">
                Select Excel file (.xlsx)
              </label>
              <input
                id="import-file"
                type="file"
                name="file"
                accept=".xlsx"
                required
                 class="block w-full rounded-lg border border-border bg-white px-3 py-2 text-sm text-ink placeholder-ink-muted shadow-sm transition cursor-pointer focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand file:rounded-md file:border-0 file:bg-brand file:text-white file:font-semibold file:cursor-pointer file:hover:bg-brand-700 file:mr-3 file:px-3 file:py-1 file:transition"
              />
            </div>
            <button
              type="submit"
              class="rounded-lg bg-brand px-6 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-brand focus:ring-offset-2 disabled:opacity-60"
            >
              Import
            </button>
          </div>
          <p class="text-xs text-ink-muted">
            Upload an Excel (.xlsx) file with columns: Title, Sport Type, Date, Duration (min), Distance (km)
          </p>
        </form>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
