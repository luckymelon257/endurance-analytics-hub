<nav class="border-b border-border bg-card/80 backdrop-blur" aria-label="Primary">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a
      href="<%= locals.user ? '/dashboard' : '/' %>"
      class="flex items-center gap-2.5 text-ink"
    >
      <span class="logo-mask h-7 w-7 text-brand" aria-hidden="true"></span>
      <span class="text-base font-bold tracking-tight">Endurance Hub</span>
    </a>

    <div class="flex items-center gap-1 text-sm sm:gap-2">
      <% if (locals.user) { %>
        <a
          href="/dashboard"
          class="rounded-lg px-3 py-2 font-medium text-ink-muted transition hover:bg-stone-100 hover:text-ink"
        >
          Dashboard
        </a>
        <a
          href="/activities"
          class="rounded-lg px-3 py-2 font-medium text-ink-muted transition hover:bg-stone-100 hover:text-ink"
        >
          Activities
        </a>
        <a
          href="/settings"
          class="rounded-lg px-3 py-2 font-medium text-ink-muted transition hover:bg-stone-100 hover:text-ink"
        >
          Settings
        </a>
        <% if (locals.user.role === 'ADMIN' || locals.user.role === 'COACH') { %>
          <a
            href="/admin/users"
            class="rounded-lg px-3 py-2 font-medium text-ink-muted transition hover:bg-stone-100 hover:text-ink"
          >
            Users
          </a>
        <% } %>

        <span class="mx-2 hidden h-5 w-px bg-border sm:inline-block" aria-hidden="true"></span>

        <span class="hidden font-medium text-ink sm:inline">
          <%= locals.user.firstName %>
        </span>

        <form method="POST" action="/auth/logout" class="inline">
          <button
            type="submit"
            class="rounded-lg px-3 py-2 font-medium text-ink-muted transition hover:bg-red-50 hover:text-red-700"
          >
            Logout
          </button>
        </form>
      <% } else { %>
        <a
          href="/auth/login"
          class="rounded-lg px-3 py-2 font-medium text-ink-muted transition hover:bg-stone-100 hover:text-ink"
        >
          Sign in
        </a>
        <a
          href="/auth/register"
          class="rounded-lg bg-brand px-4 py-2 font-semibold text-white shadow-sm transition hover:bg-brand-700"
        >
          Get started
        </a>
      <% } %>
    </div>
  </div>
</nav>
