<section
  id="settings-profile-card"
  aria-labelledby="profile-heading"
  class="overflow-hidden rounded-2xl bg-card shadow-sm ring-1 ring-border"
>
  <header class="border-b border-border px-6 py-4">
    <h2 id="profile-heading" class="text-base font-semibold text-ink">Profile</h2>
    <p class="mt-1 text-sm text-ink-muted">Your name and email address.</p>
  </header>

  <div class="flex flex-col gap-6 px-6 py-5 sm:flex-row sm:items-start">
    <%
      // Some Strava avatars are CDN-hosted at lh3.googleusercontent.com and
      // Google rate-limits (429) third-party hot-linking — fall back to initials
      // on load failure rather than showing a broken-image icon.
      const initials = (user.firstName[0] || '') + (user.lastName[0] || '')
    %>
    <div class="relative h-20 w-20 shrink-0">
      <div class="absolute inset-0 flex items-center justify-center rounded-full bg-stone-100 text-2xl font-bold text-ink-muted ring-1 ring-border">
        <%= initials %>
      </div>
      <% if (settings.strava && settings.strava.profilePictureUrl) { %>
        <img
          src="<%= settings.strava.profilePictureUrl %>"
          alt=""
          referrerpolicy="no-referrer"
          loading="lazy"
          onerror="this.style.display='none'"
          class="absolute inset-0 h-20 w-20 rounded-full object-cover ring-1 ring-border"
        />
      <% } %>
    </div>

    <div class="flex-1 space-y-6">
      <!-- Name form -->
      <form
        hx-post="/settings/profile"
        hx-target="#settings-profile-card"
        hx-swap="outerHTML"
        class="space-y-3"
      >
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="block text-sm">
            <span class="block font-medium text-ink">First name</span>
            <input
              type="text"
              name="firstName"
              value="<%= user.firstName %>"
              required
              minlength="2"
              maxlength="50"
              class="mt-1 w-full rounded-lg border border-border bg-card px-3 py-2 text-sm shadow-sm focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand"
            />
          </label>
          <label class="block text-sm">
            <span class="block font-medium text-ink">Last name</span>
            <input
              type="text"
              name="lastName"
              value="<%= user.lastName %>"
              required
              minlength="2"
              maxlength="50"
              class="mt-1 w-full rounded-lg border border-border bg-card px-3 py-2 text-sm shadow-sm focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand"
            />
          </label>
        </div>
        <div>
          <button
            type="submit"
            class="rounded-lg bg-brand px-3 py-1.5 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700"
          >
            Save name
          </button>
        </div>
      </form>

      <hr class="border-border" />

      <!-- Email block -->
      <div class="space-y-3">
        <div class="text-sm">
          <p class="font-medium text-ink">Email address</p>
          <% if (settings.isPlaceholderEmail) { %>
            <p class="mt-0.5 text-ink-muted">
              <span class="inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-800 ring-1 ring-inset ring-amber-600/20">
                No real email set
              </span>
              <span class="ml-1">Add one below so you can sign in without Strava.</span>
            </p>
          <% } else { %>
            <p class="mt-0.5 tabular-nums text-ink-muted"><%= user.email %></p>
          <% } %>
        </div>

        <% if (settings.pendingEmailChange) { %>
          <div class="flex items-start justify-between gap-3 rounded-xl bg-amber-50 px-4 py-3 text-sm text-amber-800 ring-1 ring-inset ring-amber-600/20">
            <div>
              <p class="font-medium">Pending change to <%= settings.pendingEmailChange %></p>
              <p class="text-xs">Open the confirmation link we sent to that address. The change won't take effect until you click it.</p>
            </div>
            <button
              type="button"
              hx-post="/settings/email/cancel"
              hx-target="#settings-profile-card"
              hx-swap="outerHTML"
              class="shrink-0 rounded-lg border border-amber-600/30 bg-card px-2 py-1 text-xs font-semibold text-amber-800 transition hover:bg-amber-50"
            >
              Cancel
            </button>
          </div>
        <% } %>

        <form
          hx-post="/settings/email"
          hx-target="#settings-profile-card"
          hx-swap="outerHTML"
          class="flex flex-col gap-2 sm:flex-row sm:items-end"
        >
          <label class="block flex-1 text-sm">
            <span class="block font-medium text-ink">
              <%= settings.isPlaceholderEmail ? 'Set your email' : 'New email' %>
            </span>
            <input
              type="email"
              name="newEmail"
              required
              placeholder="you@example.com"
              class="mt-1 w-full rounded-lg border border-border bg-card px-3 py-2 text-sm shadow-sm focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand"
            />
          </label>
          <button
            type="submit"
            class="rounded-lg bg-brand px-3 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700"
          >
            <%= settings.isPlaceholderEmail ? 'Add email' : 'Request change' %>
          </button>
        </form>
        <p class="text-xs text-ink-muted">
          We'll send a confirmation link to the new address. Your old email keeps working until you click it.
        </p>
      </div>
    </div>
  </div>
</section>
