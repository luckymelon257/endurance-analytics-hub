generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  COACH
  ATHLETE
}

enum SportType {
  RUNNING
  CYCLING
  SWIMMING
  ROWING
  OTHER
}

enum ActivityStatus {
  PLANNED
  COMPLETED
  SKIPPED
}

enum UserStatus {
  PENDING
  ACTIVE
  BANNED
}

enum BackfillMode {
  WINDOW_1Y
  FULL
}

enum BackfillStatus {
  QUEUED
  RUNNING
  RATE_LIMITED
  COMPLETED
  FAILED
  CANCELED
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String
  firstName       String
  lastName        String
  role            RoleName   @default(ATHLETE)
  status          UserStatus @default(PENDING)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  activities     Activity[]
  trainingBlocks TrainingBlock[]
  stravaAccount  StravaAccount?
  backfillJobs   BackfillJob[]

  @@map("users")
}

model StravaAccount {
  id                BigInt   @unique
  userId            String   @id
  accessToken       String
  refreshToken      String
  tokenExpiresAt    DateTime
  scope             String
  athleteFirstName  String?
  athleteLastName   String?
  profilePictureUrl String?
  connectedAt       DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("strava_accounts")
}

model TrainingBlock {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities Activity[]

  @@map("training_blocks")
}

model Activity {
  id                  String         @id @default(uuid())
  userId              String
  trainingBlockId     String?
  title               String
  description         String?
  sportType           SportType
  status              ActivityStatus @default(PLANNED)
  startedAt           DateTime?
  durationSeconds     Int?
  distanceMeters      Float?
  elevationGainMeters Float?
  avgHeartRate        Int?
  maxHeartRate        Int?
  avgPaceSecondsPerKm Float?
  avgPowerWatts       Int?
  calories            Int?
  externalId          String?
  isManual            Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingBlock TrainingBlock? @relation(fields: [trainingBlockId], references: [id], onDelete: SetNull)
  heartRateZones HeartRateZone[]
  laps           ActivityLap[]
  streamSet      ActivityStreamSet?

  @@index([userId, startedAt(sort: Desc)])
  @@unique([userId, externalId])
  @@map("activities")
}

model ActivityStreamSet {
  Id         String   @id
  streams    Json
  activityId String   @unique  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("activity_stream_sets")
}

model HeartRateZone {
  id                Int    @id @default(autoincrement())
  activityId        String
  zoneNumber        Int
  minBpm            Int
  maxBpm            Int
  timeInZoneSeconds Int
  percentage        Float

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("heart_rate_zones")
}

model ActivityLap {
  id                  Int    @id @default(autoincrement())
  activityId          String
  lapNumber           Int
  distanceMeters      Float
  durationSeconds     Int
  avgHeartRate        Int?
  avgPaceSecondsPerKm Float?
  elevationGainMeters Float?

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("activity_laps")
}

model BackfillJob {
  id              String         @id @default(uuid())
  userId          String
  mode            BackfillMode
  status          BackfillStatus @default(QUEUED)
  lastPageFetched Int            @default(0)
  imported        Int            @default(0)
  retryAfter      DateTime?
  error           String?
  enqueuedAt      DateTime       @default(now())
  startedAt       DateTime?
  completedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, enqueuedAt])
  @@map("backfill_jobs")
}
