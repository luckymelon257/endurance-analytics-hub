<%- include('../partials/head', { title }) %>
<%- include('../partials/navbar', {}) %>

<div class="flex min-h-[calc(100vh-4rem)] items-center justify-center py-12 px-4">
  <div class="w-full max-w-sm">
    <h2 class="text-center text-2xl font-bold text-gray-900 mb-8">Create your account</h2>

    <% const stravaErrorMessages = {
        denied:   'You declined the Strava authorization. You can try again anytime.',
        invalid:  'That Strava authorization link expired or was invalid. Please retry.',
        scope:    'Strava authorization is missing a required permission. Please retry and accept all permissions.',
        conflict: 'That Strava account is already connected to another user.',
        failed:   'Something went wrong while connecting to Strava. Please try again.',
    } %>
    <% const stravaError = locals.query && locals.query.strava_error %>
    <% if (stravaError && stravaErrorMessages[stravaError]) { %>
      <div class="mb-4 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700 ring-1 ring-red-600/20">
        <%= stravaErrorMessages[stravaError] %>
      </div>
    <% } %>

    <form method="POST" action="/auth/register" class="space-y-4">
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label for="firstName" class="block text-sm font-medium text-gray-700 mb-1">First name</label>
          <input id="firstName" type="text" name="firstName" required
            class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm
                   focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent" />
        </div>
        <div>
          <label for="lastName" class="block text-sm font-medium text-gray-700 mb-1">Last name</label>
          <input id="lastName" type="text" name="lastName" required
            class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm
                   focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent" />
        </div>
      </div>
      <div>
        <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
        <input id="email" type="email" name="email" required autocomplete="email"
          class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm
                 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent" />
      </div>
      <div>
        <label for="password" class="block text-sm font-medium text-gray-700 mb-1">Password</label>
        <input id="password" type="password" name="password" required minlength="8"
          class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm
                 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent" />
        <p class="mt-1 text-xs text-gray-400">Minimum 8 characters</p>
      </div>
      <button type="submit"
        class="w-full rounded-lg bg-blue-600 py-2 text-sm font-semibold text-white shadow-sm
               hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2">
        Create account
      </button>
    </form>

    <div class="my-6 flex items-center gap-3 text-xs uppercase tracking-wide text-gray-400">
      <div class="flex-1 border-t border-gray-200"></div>
      <span>or</span>
      <div class="flex-1 border-t border-gray-200"></div>
    </div>

    <a href="/auth/strava/connect"
      class="flex w-full items-center justify-center gap-2 rounded-lg bg-orange-600 py-2 text-sm font-semibold text-white shadow-sm
             hover:bg-orange-700 focus:outline-none focus:ring-2 focus:ring-orange-600 focus:ring-offset-2">
      <span aria-hidden="true">🟧</span>
      Connect with Strava
    </a>

    <p class="mt-6 text-center text-sm text-gray-500">
      Already have an account?
      <a href="/auth/login" class="text-blue-600 hover:underline font-medium">Sign in</a>
    </p>
  </div>
</div>

<%- include('../partials/footer') %>
