<%- include('../partials/head', { title }) %>
<%- include('../partials/navbar', {}) %>

<div class="flex min-h-[calc(100vh-4rem)] items-center justify-center py-12 px-4">
  <div class="w-full max-w-md text-center">
    <div class="mx-auto mb-6 flex h-14 w-14 items-center justify-center rounded-full bg-red-50 ring-1 ring-red-600/10">
      <svg class="h-7 w-7 text-red-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m0 3h.008m-9.97 3.75h19.94c1.155 0 1.875-1.25 1.298-2.25L13.298 4.5a1.5 1.5 0 00-2.598 0L2.732 17.25c-.577 1 .143 2.25 1.298 2.25z" />
      </svg>
    </div>
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Verification failed</h2>
    <p class="text-sm text-gray-600 mb-8">
      This verification link is invalid or has expired. Enter your email below and we'll send you a fresh one.
    </p>

    <form method="POST" action="/auth/resend-verification" class="space-y-3 text-left">
      <div>
        <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
        <input id="email" type="email" name="email" required autocomplete="email"
          class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm
                 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent" />
      </div>
      <button type="submit"
        class="w-full rounded-lg bg-blue-600 py-2 text-sm font-semibold text-white shadow-sm
               hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2">
        Send a new link
      </button>
    </form>

    <p class="mt-6 text-sm text-gray-500">
      <a href="/auth/login" class="text-blue-600 hover:underline font-medium">Back to sign in</a>
    </p>
  </div>
</div>

<%- include('../partials/footer') %>
