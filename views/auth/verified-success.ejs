<%- include('../partials/head', { title }) %>
<%- include('../partials/navbar', {}) %>

<div class="flex min-h-[calc(100vh-4rem)] items-center justify-center py-12 px-4">
  <div class="w-full max-w-md text-center">
    <div class="mx-auto mb-6 flex h-14 w-14 items-center justify-center rounded-full bg-green-50 ring-1 ring-green-600/10">
      <svg class="h-7 w-7 text-green-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
      </svg>
    </div>
    <h2 class="text-2xl font-bold text-gray-900 mb-2">Email verified</h2>
    <p class="text-sm text-gray-600 mb-8">
      Your account is now active. You can sign in and start tracking your training.
    </p>
    <a href="/auth/login"
      class="inline-block rounded-lg bg-blue-600 px-5 py-2 text-sm font-semibold text-white shadow-sm
             hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2">
      Continue to sign in
    </a>
  </div>
</div>

<%- include('../partials/footer') %>
