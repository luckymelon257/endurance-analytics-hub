<div
  id="toast-host"
  aria-live="polite"
  aria-atomic="true"
  class="pointer-events-none fixed inset-x-0 bottom-4 z-50 flex flex-col items-center gap-2 px-4 sm:bottom-6"
></div>

<script>
  (function () {
    // hx-boost swaps body innerHTML on every navigation, which re-runs this
    // script. Without a guard we'd attach a new showToast listener each time
    // and accumulate them across navigations. The flag pins setup to once per
    // page load.
    if (window.__toastHostInit) return
    window.__toastHostInit = true

    var KIND_CLASSES = {
      success: 'bg-emerald-600 text-white ring-emerald-700/40',
      error:   'bg-rose-600 text-white ring-rose-700/40',
      info:    'bg-ink text-white ring-black/40',
    }

    function showToast(message, kind) {
      // Look the host up at event time — under hx-boost the DOM node is
      // replaced on every navigation, so a closure-captured reference would
      // dangle.
      var host = document.getElementById('toast-host')
      if (!host) return
      var classes = KIND_CLASSES[kind] || KIND_CLASSES.info
      var el = document.createElement('div')
      el.setAttribute('role', 'status')
      el.className =
        'pointer-events-auto max-w-sm rounded-xl px-4 py-2.5 text-sm font-medium shadow-lg ring-1 ' +
        'transition transform opacity-0 translate-y-2 ' + classes
      el.textContent = message
      host.appendChild(el)
      requestAnimationFrame(function () {
        el.classList.remove('opacity-0', 'translate-y-2')
      })
      setTimeout(function () {
        el.classList.add('opacity-0', 'translate-y-2')
        setTimeout(function () { el.remove() }, 250)
      }, 4000)
    }

    // HTMX dispatches a CustomEvent on body for every key in the HX-Trigger
    // header. Server emits HX-Trigger: {"showToast": {"message": "...", "kind": "success"}}
    document.body.addEventListener('showToast', function (e) {
      var detail = (e && e.detail) || {}
      if (!detail.message) return
      showToast(String(detail.message), detail.kind || 'info')
    })
  })()
</script>
