<nav class="bg-white shadow-sm border-b border-gray-200">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 justify-between items-center">
      <a href="<%= locals.user ? '/dashboard' : '/' %>" class="text-xl font-bold text-blue-600">
        Endurance Hub
      </a>

      <div class="flex items-center gap-6 text-sm">
        <% if (locals.user) { %>
          <a href="/dashboard"   class="text-gray-600 hover:text-blue-600 font-medium">Dashboard</a>
          <a href="/activities"  class="text-gray-600 hover:text-blue-600 font-medium">Activities</a>
          <% if (locals.user.role === 'ADMIN' || locals.user.role === 'COACH') { %>
            <a href="/admin/users" class="text-gray-600 hover:text-blue-600 font-medium">Users</a>
          <% } %>
          <span class="text-gray-400">|</span>
          <span class="text-gray-700 font-medium"><%= locals.user.firstName %></span>
          <form method="POST" action="/auth/logout" class="inline">
            <button type="submit" class="text-gray-500 hover:text-red-600 font-medium">Logout</button>
          </form>
        <% } else { %>
          <a href="/auth/login"    class="text-gray-600 hover:text-blue-600 font-medium">Login</a>
          <a href="/auth/register" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 font-medium">Register</a>
        <% } %>
      </div>
    </div>
  </div>
</nav>
