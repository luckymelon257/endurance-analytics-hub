<section
  id="settings-password-card"
  aria-labelledby="password-heading"
  class="overflow-hidden rounded-2xl bg-card shadow-sm ring-1 ring-border"
>
  <header class="border-b border-border px-6 py-4">
    <h2 id="password-heading" class="text-base font-semibold text-ink">Password</h2>
    <% if (settings.isPlaceholderEmail) { %>
      <p class="mt-1 text-sm text-ink-muted">Add a password so you can sign in without Strava.</p>
    <% } else { %>
      <p class="mt-1 text-sm text-ink-muted">Change the password used for email sign-in.</p>
    <% } %>
  </header>

  <form
    hx-post="/settings/password"
    hx-target="#settings-password-card"
    hx-swap="outerHTML"
    class="space-y-3 px-6 py-5"
  >
    <% if (!settings.isPlaceholderEmail) { %>
      <label class="block text-sm">
        <span class="block font-medium text-ink">Current password</span>
        <input
          type="password"
          name="currentPassword"
          required
          autocomplete="current-password"
          class="mt-1 w-full rounded-lg border border-border bg-card px-3 py-2 text-sm shadow-sm focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand"
        />
      </label>
    <% } %>

    <label class="block text-sm">
      <span class="block font-medium text-ink">
        <%= settings.isPlaceholderEmail ? 'New password' : 'New password' %>
      </span>
      <input
        type="password"
        name="newPassword"
        required
        minlength="8"
        maxlength="72"
        autocomplete="new-password"
        class="mt-1 w-full rounded-lg border border-border bg-card px-3 py-2 text-sm shadow-sm focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand"
      />
      <span class="mt-1 block text-xs text-ink-muted">At least 8 characters.</span>
    </label>

    <div>
      <button
        type="submit"
        class="rounded-lg bg-brand px-3 py-1.5 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700"
      >
        <%= settings.isPlaceholderEmail ? 'Set password' : 'Change password' %>
      </button>
    </div>
  </form>
</section>
