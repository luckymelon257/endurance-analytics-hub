<%- include('partials/head', { title }) %>
<%- include('partials/navbar', { user }) %>

<main class="mx-auto flex min-h-screen max-w-4xl flex-col px-4 py-8 sm:px-6 lg:px-8">
  <header class="mb-8">
    <h1 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">Settings</h1>
    <p class="mt-1 text-sm text-ink-muted">Manage your profile, sign-in credentials, and connected services.</p>
  </header>

  <% if (flash) { %>
    <div
      role="status"
      class="<%= flash.kind === 'success'
        ? 'mb-6 rounded-xl bg-emerald-50 px-4 py-3 text-sm text-emerald-800 ring-1 ring-inset ring-emerald-600/20'
        : 'mb-6 rounded-xl bg-rose-50 px-4 py-3 text-sm text-rose-800 ring-1 ring-inset ring-rose-600/20' %>"
    >
      <%= flash.message %>
    </div>
  <% } %>

  <div class="space-y-6">
    <%- include('partials/settings-profile', { settings, user }) %>
    <%- include('partials/settings-password', { settings, user }) %>
    <%- include('partials/settings-connections', { settings, user }) %>
    <%- include('partials/settings-danger', { settings, user }) %>
  </div>
</main>

<%- include('partials/footer') %>
