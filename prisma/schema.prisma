generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  COACH
  ATHLETE
}

enum SportType {
  RUNNING
  CYCLING
  SWIMMING
  ROWING
  OTHER
}

enum ActivityStatus {
  PLANNED
  COMPLETED
  SKIPPED
}

enum UserStatus {
  PENDING
  ACTIVE
  BANNED
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String
  firstName       String
  lastName        String
  role            RoleName   @default(ATHLETE)
  status          UserStatus @default(PENDING)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  activities     Activity[]
  trainingBlocks TrainingBlock[]

  @@map("users")
}

model TrainingBlock {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities Activity[]

  @@map("training_blocks")
}

model Activity {
  id                  String         @id @default(uuid())
  userId              String
  trainingBlockId     String?
  title               String
  description         String?
  sportType           SportType
  status              ActivityStatus @default(PLANNED)
  startedAt           DateTime?
  durationSeconds     Int?
  distanceMeters      Float?
  elevationGainMeters Float?
  avgHeartRate        Int?
  maxHeartRate        Int?
  avgPaceSecondsPerKm Float?
  avgPowerWatts       Int?
  calories            Int?
  externalId          String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingBlock TrainingBlock? @relation(fields: [trainingBlockId], references: [id], onDelete: SetNull)
  heartRateZones HeartRateZone[]
  laps           ActivityLap[]

  @@map("activities")
}

model HeartRateZone {
  id                Int    @id @default(autoincrement())
  activityId        String
  zoneNumber        Int
  minBpm            Int
  maxBpm            Int
  timeInZoneSeconds Int
  percentage        Float

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("heart_rate_zones")
}

model ActivityLap {
  id                  Int    @id @default(autoincrement())
  activityId          String
  lapNumber           Int
  distanceMeters      Float
  durationSeconds     Int
  avgHeartRate        Int?
  avgPaceSecondsPerKm Float?
  elevationGainMeters Float?

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("activity_laps")
}
